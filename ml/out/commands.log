PYTHONPATH=ml ml/.venv/bin/python - <<'PY'
import csv,json
from pathlib import Path
from types import SimpleNamespace
import torch
from flipup_ml.audit import audit
from flipup_ml.data import domain
from flipup_ml.run import report
out=Path("ml/out")
entries,a=audit("ml/data/fixtures",out)
newdomain=domain(entries)
artifact=torch.load(out/"model.pt",map_location="cpu",weights_only=True)
for spot,item in newdomain.items():
    assert item["unresolved_combos"]==[]
    assert all(item[k]==artifact["domain"][spot][k] for k in ("pot","stack","roots","nodes"))
artifact["domain"]=newdomain
torch.save(artifact,out/"model.pt")
values=json.loads((out/"metrics.json").read_text())
values["costs"]["checkpoint_bytes"]=(out/"model.pt").stat().st_size
(out/"metrics.json").write_text(json.dumps(values,indent=2))
training=json.loads((out/"training.json").read_text()); training["costs"]=values["costs"]
(out/"training.json").write_text(json.dumps(training,indent=2))
curve=list(csv.DictReader((out/"learning_curve.csv").open()))
for r in curve:
    for k in ("fraction","wall_seconds"): r[k]=float(r[k])
    for k in ("training_rank_triples","training_boards"): r[k]=int(r[k])
report(SimpleNamespace(),out,values,a,curve)
solves=json.loads((out/"local_solves.json").read_text())
fixture_seconds=sum(x.get("seconds",0) for x in solves)
with (out/"report.md").open("a") as f:
    f.write(f"\nLocal solve budget: {len(solves)} calls total: 12 invented-range flop fixtures plus three existing river test cases. Fixture solve wall time was {fixture_seconds:.2f} seconds; individual CPU time was not measured. The 20-solve cap was respected.\n\nThe neural batch timing excludes feature generation. The cold whole-range interface is much slower because it computes sampled root equities; it is not a sub-millisecond end-to-end service.\n")
smoke=json.loads((out/"inference-smoke.json").read_text())
assert smoke["supported"] and smoke["evidence"]=="synthetic_fixture_only" and len(smoke["hands"])==1
print("Final domain validated; checkpoint bytes",values["costs"]["checkpoint_bytes"])
print((out/"tests.log").read_text())
PY
# exit=0

