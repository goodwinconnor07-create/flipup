import json,numpy as np,time
from pathlib import Path
from collections import Counter
start=time.perf_counter(); totals=Counter(); combos=Counter()
for p in Path("ml/data/flops").rglob("*.npz"):
    with np.load(p) as f:
        m=json.loads(str(f["meta"]))
        if m["exploitability_pct"]>.5: continue
        ns=[len(f["combos0"]),len(f["combos1"])]
        totals[p.parent.name]+=sum(ns[n["player"]] for n in m["nodes"].values())
        combos[p.parent.name]+=sum(ns)
print("Rows",dict(totals),"total",sum(totals.values()),"root-hand-equity calculations",sum(combos.values()),"seconds",time.perf_counter()-start)
Path("ml/out/real/row_counts.json").write_text(json.dumps({"rows_per_spot":dict(totals),"rows":sum(totals.values()),"root_equity_hands":sum(combos.values())},indent=2))
PY
