# 2026-10-22T11:03:00.682571+00:00 cwd=/workspace/flipup
PYTHONPATH=ml ml/.venv/bin/python - <<'PY'
from flipup_ml.data import load_entries
import numpy as np,json
from pathlib import Path
entries,_,_=load_entries("ml/data/flops")
result={}
for spot in sorted({e.spot for e in entries}):
    es=[e for e in entries if e.spot==spot]
    result[spot]={}
    for player in (0,1):
        values=np.stack([e.roots[player] for e in es]).astype(float)
        from flipup_gto.cards import combo_cards
        for i,e in enumerate(es):
            for c in range(1326):
                if set(combo_cards(c))&set(e.board): values[i,c]=np.nan
        spans=np.nanmax(values,axis=0)-np.nanmin(values,axis=0)
        result[spot][player]={"max_abs_span":float(np.nanmax(spans)),"combos_with_nonidentical_stored_root_weights":int(np.sum(spans>0))}
print(json.dumps(result,indent=2))
Path("ml/out/real/strict_range_comparison.json").write_text(json.dumps(result,indent=2))
assert all(v["combos_with_nonidentical_stored_root_weights"]==0 for spot in result.values() for v in spot.values())
PY

