import hashlib,json,zipfile
from pathlib import Path
from flipup_ml.unpack import unpack
manifest=json.loads(Path("/workspace/attachments/cb9f5c3d-429d-49e3-aa72-c603fbe18ad2/MANIFEST.json").read_text())
parts={p.name:p for p in Path("/workspace/attachments").rglob("flipup-flops-part*-of-07.zip")}
assert set(parts)=={x["part"] for x in manifest}
verified=[]
for item in manifest:
    p=parts[item["part"]]
    assert p.stat().st_size==item["bytes"],p
    assert hashlib.sha256(p.read_bytes()).hexdigest()==item["sha256"],p
    with zipfile.ZipFile(p) as z:
        members=[x for x in z.infolist() if not x.is_dir()]
        assert len(members)==item["files"],p
        print(p.name,"verified",len(members),"files; first:",members[0].filename,flush=True)
    verified.append(item)
count=unpack([parts[x["part"]] for x in manifest],"ml/data/flops")
assert count==sum(x["files"] for x in manifest)
Path("ml/out/real/input_manifest.json").write_text(json.dumps(verified,indent=2))
print("Extracted",count,"NPZ files",flush=True)
from flipup_ml.audit import audit
entries,a=audit("ml/data/flops","ml/out/real")
print("Audit summary",{k:a[k] for k in ["retained_files","files_per_spot","distinct_boards","intersection_all_six_spots","max_action_count","node_counts","exploitability_pct"]},flush=True)
