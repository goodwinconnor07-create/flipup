import json,time,numpy as np
from pathlib import Path
from flipup_ml.data import read_entry
from flipup_gto import _engine
results=[]
for spot in ["btn_bb","bb_btn_3bet"]:
    e=read_entry(next(Path("ml/data/flops",spot).glob("*.npz")))
    for p in (0,1):
        cs=e.arrays[f"combos{p}"]; hero=np.zeros(1326); hero[cs]=1
        start=time.perf_counter(); eq=np.asarray(_engine.range_equities(hero.tolist(),e.roots[1-p].tolist(),list(e.board),1024,20261022))[cs]
        stored=e.arrays[f"equity{p}"].astype(float); err=abs(eq-stored)
        result={"spot":spot,"board":e.path.stem,"player":p,"hands":len(cs),"seconds":time.perf_counter()-start,"max_abs_difference":float(err.max()),"mean_abs_difference":float(err.mean())}
        results.append(result); print(result,flush=True)
Path("ml/out/real/equity_verification.json").write_text(json.dumps(results,indent=2))
PY
