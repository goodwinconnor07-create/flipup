PYTHONPATH=ml ml/.venv/bin/python - <<'PY'
from pathlib import Path
import json,subprocess
start=Path("ml/.venv/pyvenv.cfg").stat().st_mtime
for directory in [Path("gto/flipup_gto/__pycache__"),Path("gto/tests/__pycache__")]:
    if not directory.exists(): continue
    files=list(directory.iterdir())
    if any(p.suffix!=".pyc" or p.stat().st_mtime<start for p in files):
        raise RuntimeError("Unexpected pre-existing cache; preserve it")
    for p in files: p.unlink()
    directory.rmdir()
    print("Removed generated cache",directory)
status=subprocess.check_output(["git","status","--porcelain","--untracked-files=all"],text=True)
assert all(line[3:].startswith("ml/") for line in status.splitlines()),status
assert subprocess.check_output(["git","branch","--show-current"],text=True).strip()=="codex/gto-ev-model"
assert not subprocess.check_output(["git","diff","--name-only"],text=True)
