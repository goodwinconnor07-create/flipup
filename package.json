{
  "name": "flipup",
  "private": true,
  "version": "0.1.0",
  "description": "FlipUp: no-limit Texas Hold'em with friends, each on their own phone.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "dead": "node scripts/deadCode.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test:native": "vitest run --config native/vitest.config.mts",
    "bot:demo": "tsx scripts/humanPoker.ts simulate",
    "bot:generate": "tsx scripts/humanPoker.ts generate",
    "bot:evaluate": "tsx scripts/humanPoker.ts evaluate",
    "bot:preflop": "tsx scripts/evaluatePreflop.ts",
    "bot:personalities": "tsx scripts/evaluatePersonalities.ts",
    "bot:everyday": "tsx scripts/evaluateEveryday.ts",
    "bot:feel": "tsx scripts/botFeel.ts",
    "bot:flops": "tsx scripts/flopLab.ts",
    "bot:director": "tsx scripts/botDirector.ts",
    "bot:small-bets": "tsx scripts/smallBetLab.ts",
    "bot:explain": "tsx scripts/explainHand.ts",
    "bot:variants": "tsx scripts/variantFeel.ts",
    "bot:planning": "tsx scripts/evaluatePlanning.ts",
    "bot:ranges": "tsx scripts/analyseBotRanges.ts",
    "bot:realism": "tsx scripts/evaluateRealism.ts",
    "bot:responses": "tsx scripts/calibrateResponses.ts",
    "bot:responses-v2": "tsx scripts/calibrateResponsesV2.ts",
    "bot:heads-up": "tsx scripts/diagnoseHeadsUp.ts",
    "bot:experience": "tsx scripts/evaluateLiveExperience.ts",
    "bot:decision-worlds": "tsx scripts/reviewHeadsUpDecisions.ts",
    "bot:compare-responses": "tsx scripts/evaluateCalibrated.ts",
    "bot:behavior": "tsx scripts/evaluatePublicBehavior.ts",
    "bot:decision-quality": "tsx scripts/auditDecisionQuality.ts",
    "bot:improve": "tsx scripts/improveBots.ts",
    "bot:persistence": "tsx scripts/botPersistence.ts",
    "bot:calibrate": "tsx scripts/humanPoker.ts calibrate",
    "bot:train": "tsx scripts/trainBot.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "prettier": "^3.8.1",
    "tsx": "4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
