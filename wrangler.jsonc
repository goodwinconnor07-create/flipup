// Cloudflare config for FlipUp.
// One Worker serves the built app (static assets) and the online table API.
// Each table lives in its own TableRoom Durable Object, keyed by join code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flipup",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  // The app's own domain. Wrangler adds the DNS records and the certificate on deploy.
  "routes": [
    { "pattern": "gtoduel.online", "custom_domain": true },
    { "pattern": "www.gtoduel.online", "custom_domain": true },
  ],
  "compatibility_date": "2026-10-01",
  "assets": {
    // Unknown paths (like /ABCDE join links) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker code; everything else is served as a static file.
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "TABLE_ROOM", "class_name": "TableRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TableRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["TwinShare"] },
    // AI twins are gone, so their shared copies go with them.
    { "tag": "v3", "deleted_classes": ["TwinShare"] },
  ],
  "observability": { "enabled": true },
}
