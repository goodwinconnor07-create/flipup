// Cloudflare config for FlipUp.
// One Worker serves the built app (static assets) and the online table API.
// Each table lives in its own TableRoom Durable Object, keyed by join code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flipup",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  // The app's own domain (playflipup.com, the main one) and the old one, kept so links and builds that still use it
  // keep working. Wrangler adds the DNS records and the certificate on deploy.
  "routes": [
    { "pattern": "playflipup.com", "custom_domain": true },
    { "pattern": "www.playflipup.com", "custom_domain": true },
    { "pattern": "gtoduel.online", "custom_domain": true },
    { "pattern": "www.gtoduel.online", "custom_domain": true },
  ],
  "compatibility_date": "2026-10-01",
  "assets": {
    // Unknown paths (like /ABCDE join links) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only API calls (and the app-links file) reach the Worker code; everything else is served as a static file.
    "run_worker_first": ["/api/*", "/.well-known/*"],
    "binding": "ASSETS",
  },
  "durable_objects": {
    "bindings": [
      { "name": "TABLE_ROOM", "class_name": "TableRoom" },
      { "name": "PARTY_ROOM", "class_name": "PartyRoom" },
      { "name": "FRIEND_CARD", "class_name": "FriendCard" },
      { "name": "BLACKJACK_ROOM", "class_name": "BlackjackRoom" },
      { "name": "REPORT_BOX", "class_name": "ReportBox" },
      { "name": "BOT_RESEARCH", "class_name": "BotResearchRoom" },
      { "name": "ENTITLEMENTS", "class_name": "Entitlements" },
      { "name": "BANKROLL_ROOM", "class_name": "BankrollRoom" },
      { "name": "LEADERBOARD", "class_name": "Leaderboard" },
    ],
  },
  // Production already recorded v3 without the classes below ever being created, so they are all made in v4.
  // v2 and v3 are kept (empty) so the tags match what Cloudflare has.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TableRoom"] },
    { "tag": "v2" },
    { "tag": "v3" },
    { "tag": "v4", "new_sqlite_classes": ["TwinShare", "PartyRoom", "FriendCard"] },
    // Shared AI twins are gone from the app; this removes their Durable Object class.
    { "tag": "v5", "deleted_classes": ["TwinShare"] },
    // Blackjack tables with friends, one per table.
    { "tag": "v6", "new_sqlite_classes": ["BlackjackRoom"] },
    // Player reports (App Store guideline 1.2), one instance named "reports".
    { "tag": "v7", "new_sqlite_classes": ["ReportBox"] },
    // Who has bought FlipUp Premium (checked against Apple's signed purchases), one instance named "premium".
    { "tag": "v8", "new_sqlite_classes": ["Entitlements"] },
    // Bankroll: one room per player per month, and the boards (bankroll by month, Today's three by day).
    { "tag": "v9", "new_sqlite_classes": ["BankrollRoom", "Leaderboard"] },
    // Private, opt-in bot research sessions. Each expires after 30 days.
    { "tag": "v10", "new_sqlite_classes": ["BotResearchRoom"] },
  ],
  // Every hour: the Sunday cut once it's due, and closing last month's board (badges) on the 1st. Both are safe to run twice.
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // "1" makes the server refuse Premium games and looks to phones that haven't shown a purchase. Leave it "0" until the
    // iPhone app is the only client that can host them (the web app has no payment yet) and the App Store Server Notifications URL is set.
    "PREMIUM_ENFORCED": "1",
    "APPLE_BUNDLE_ID": "com.goodwin.flipup",
    // Your Apple Developer Team ID (10 characters, Membership details in the developer portal; the same value as the
    // APPLE_TEAM_ID GitHub secret). Join links open the app only once this is set and the Worker is deployed.
    "APPLE_TEAM_ID": "9FAJRHL979",
    "APPLE_PREMIUM_PRODUCT_ID": "flipup.premium.unlock",
    // FlipUp Premium's monthly and yearly subscriptions (native/appInfo.ts), comma separated.
    "APPLE_PREMIUM_SUB_IDS": "flipup.premium.monthly,flipup.premium.yearly",
  },
  "observability": { "enabled": true },
}
