// Cloudflare config for FlipUp.
// One Worker serves the built app (static assets) and the online table API.
// Each table lives in its own TableRoom Durable Object, keyed by join code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flipup",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  // The app's own domain. Wrangler adds the DNS records and the certificate on deploy.
  "routes": [
    { "pattern": "gtoduel.online", "custom_domain": true },
    { "pattern": "www.gtoduel.online", "custom_domain": true },
  ],
  "compatibility_date": "2026-10-01",
  "assets": {
    // Unknown paths (like /ABCDE join links) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker code; everything else is served as a static file.
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "TABLE_ROOM", "class_name": "TableRoom" },
      { "name": "PARTY_ROOM", "class_name": "PartyRoom" },
      { "name": "FRIEND_CARD", "class_name": "FriendCard" },
      { "name": "BLACKJACK_ROOM", "class_name": "BlackjackRoom" },
      { "name": "REPORT_BOX", "class_name": "ReportBox" },
      { "name": "ENTITLEMENTS", "class_name": "Entitlements" },
    ],
  },
  // Production already recorded v3 without the classes below ever being created, so they are all made in v4.
  // v2 and v3 are kept (empty) so the tags match what Cloudflare has.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TableRoom"] },
    { "tag": "v2" },
    { "tag": "v3" },
    { "tag": "v4", "new_sqlite_classes": ["TwinShare", "PartyRoom", "FriendCard"] },
    // Shared AI twins are gone from the app; this removes their Durable Object class.
    { "tag": "v5", "deleted_classes": ["TwinShare"] },
    // Blackjack tables with friends, one per table.
    { "tag": "v6", "new_sqlite_classes": ["BlackjackRoom"] },
    // Player reports (App Store guideline 1.2), one instance named "reports".
    { "tag": "v7", "new_sqlite_classes": ["ReportBox"] },
    // Who has bought FlipUp Premium (checked against Apple's signed purchases), one instance named "premium".
    { "tag": "v8", "new_sqlite_classes": ["Entitlements"] },
  ],
  "vars": {
    // "1" makes the server refuse Premium games and looks to phones that haven't shown a purchase. Leave it "0" until the
    // iPhone app is the only client that can host them (the web app has no payment yet) and ENTITLEMENT_SECRET is set.
    "PREMIUM_ENFORCED": "0",
    "APPLE_BUNDLE_ID": "com.goodwin.flipup",
    "APPLE_PREMIUM_PRODUCT_ID": "flipup.premium.unlock",
  },
  "observability": { "enabled": true },
}
