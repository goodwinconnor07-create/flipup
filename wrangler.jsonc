// Cloudflare config for FlipUp.
// One Worker serves the built app (static assets) and the online table API.
// Each table lives in its own TableRoom Durable Object, keyed by join code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flipup",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  // The app's own domain. Wrangler adds the DNS records and the certificate on deploy.
  "routes": [
    { "pattern": "gtoduel.online", "custom_domain": true },
    { "pattern": "www.gtoduel.online", "custom_domain": true },
  ],
  "compatibility_date": "2026-10-01",
  "assets": {
    // Unknown paths (like /ABCDE join links) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker code; everything else is served as a static file.
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "TABLE_ROOM", "class_name": "TableRoom" },
      // A shared AI twin: one per five letter code (see worker/twinShare.ts).
      { "name": "TWIN_SHARE", "class_name": "TwinShare" },
      // A party tournament (worker/party.ts) and a friend code (worker/friendCard.ts), each keyed by its five letter code.
      { "name": "PARTY_ROOM", "class_name": "PartyRoom" },
      { "name": "FRIEND_CARD", "class_name": "FriendCard" },
    ],
  },
  // Production already recorded v3 without the classes below ever being created, so they are all made in v4.
  // v2 and v3 are kept (empty) so the tags match what Cloudflare has.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TableRoom"] },
    { "tag": "v2" },
    { "tag": "v3" },
    { "tag": "v4", "new_sqlite_classes": ["TwinShare", "PartyRoom", "FriendCard"] },
  ],
  "observability": { "enabled": true },
  // Where the GTO coach service (gto/, a separate Python server) runs. /api/gto/* is proxied there.
  // Hosted on Fly.io (gto/fly.toml). For local work override it in .dev.vars (e.g. http://127.0.0.1:8000).
  "vars": { "GTO_URL": "https://flipup-gto.fly.dev" },
}
